# ============================================================
#  Custodian Engine - .gitignore
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
build/
dist/
*.egg-info/
.eggs/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.hypothesis/

# ---- Node / Vite (frontend) ----
node_modules/
frontend/dist/
frontend/.vite/
*.local

# ---- Bazy danych / snapshoty ----
*.sqlite
*.sqlite3
*.db

# ---- IDE / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ============================================================
#  ASSETY
#  Dane gry (JSON/properties) WCHODZA do repo, zeby `git clone`
#  wystarczal do uruchomienia silnika (~5 MB). Grafiki i fonty
#  pozostaja ignorowane na stale (setki MB) - frontend bierze je
#  z CDN AsyncTI4 (images.asyncti4.com).
# ============================================================

# Domyslnie ignoruj caly katalog assetow...
assets/*

# ...ale wersjonuj konfiguracje i dane potrzebne silnikowi:
!assets/enabled_sources.json
!assets/data/
!assets/systems/
!assets/planets/
!assets/alias/

# Grafiki i fonty NIE wchodza do repo (setki MB) - leca z CDN:
assets/**/*.png
assets/**/*.webp
assets/**/*.jpg
assets/**/*.jpeg
assets/**/*.gif
assets/**/*.svg
assets/**/*.ttf
assets/**/*.otf
assets/**/*.woff
assets/**/*.woff2
assets/**/*.mp3
assets/**/*.mp4
assets/**/*.webm

#ignorowanie plików asynca
TI4_map_generator_bot/

# ---- Frontend (Vite build output) ----
frontend/build/
frontend/node_modules/
TI4_map_generator_bot.rar
