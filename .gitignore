# ============================================================
#  Custodian Engine - .gitignore
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
build/
dist/
*.egg-info/
.eggs/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.hypothesis/

# ---- Node / Vite (frontend) ----
node_modules/
frontend/dist/
frontend/.vite/
*.local

# ---- Bazy danych / snapshoty ----
*.sqlite
*.sqlite3
*.db

# ---- IDE / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ============================================================
#  ASSETY
#  Na start (wizytowka) assety NIE wchodza do repo.
#  Grafiki/fonty pozostaja ignorowane na stale (setki MB).
#  Dane JSON zostana wlaczone pozniej przez wyjatki ponizej.
# ============================================================

# Ignoruj zawartosc katalogu assetow na start...
assets/*

# ...ale manifest aktywnych zrodel to konfiguracja, nie dane gry - wersjonujemy
!assets/enabled_sources.json

# ---- Przyszle wyjatki dla wyselekcjonowanych danych (odkomentuj w kroku M1) ----
# !assets/
# assets/*
# !assets/data/
# !assets/systems/
# Grafiki/fonty pozostaja ignorowane nawet po wlaczeniu danych:
# *.png
# *.webp
# *.jpg
# *.jpeg
# *.gif
# *.ttf
# *.otf
# *.woff
# *.woff2

#ignorowanie plików asynca
ti4_web_new-main/
TI4_map_generator_bot/
